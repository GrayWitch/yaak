{
  "compilerOptions": {
    "target": "es2021",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "strict": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@yaakapp-internal/lib": ["../common-lib/index.ts"],
      "@yaakapp-internal/lib/*": ["../common-lib/*"]
    }
  },
  "include": ["src"]
}
